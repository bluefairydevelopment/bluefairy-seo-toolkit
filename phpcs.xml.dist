<?xml version="1.0"?>
<ruleset name="BlueFairy SEO Toolkit">
	<description>WordPress Coding Standards + strict types for BlueFairy SEO Toolkit.</description>

	<file>bluefairy-seo-toolkit.php</file>
	<file>uninstall.php</file>
	<file>includes/</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/tests/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>

	<arg name="basepath" value="."/>
	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<!-- The plugin header says Requires PHP: 8.1. -->
	<config name="testVersion" value="8.1-"/>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress">
		<!-- Allow short array syntax -->
		<exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
		<!-- PSR-4 class files: includes/Head/DocumentTitle.php, not class-document-title.php -->
		<exclude name="WordPress.Files.FileName"/>
	</rule>

	<!-- Require declare(strict_types=1) in every file -->
	<rule ref="Generic.PHP.RequireStrictTypes"/>

	<!-- Enforce the plugin text domain -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="bluefairy-seo-toolkit"/>
			</property>
		</properties>
	</rule>

	<!-- Enforce naming prefixes for globals, constants, and hooks -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="bfst"/>
				<element value="bluefairy_seo_toolkit"/>
				<element value="BlueFairy\SeoToolkit"/>
				<element value="BFST"/>
			</property>
		</properties>
	</rule>

</ruleset>
