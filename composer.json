{
    "name": "bluefairy/seo-toolkit",
    "description": "Open Graph tags and XML sitemaps for WordPress — no bloat, no configuration.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Blue Fairy Development",
            "homepage": "https://bluefairydevelopment.com"
        }
    ],
    "require": {},
    "require-dev": {
        "phpunit/phpunit": "^10",
        "phpstan/phpstan": "^1.10",
        "szepeviktor/phpstan-wordpress": "^0.7",
        "squizlabs/php_codesniffer": "^3.8",
        "wp-coding-standards/wpcs": "^3.0",
        "php-stubs/woocommerce-stubs": "^9.0"
    },
    "autoload-dev": {
        "psr-4": {
            "BlueFairy\\SeoToolkit\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
